# Multi key + round-robin + failover. Isi satu key per baris (vertical):
# Loader otomatis membaca ONEHOP_API_KEY_1, ONEHOP_API_KEY_2, ... hingga N
# tanpa perlu di-hardcode. Baris kosong dilewati.
ONEHOP_API_KEY_1=
ONEHOP_API_KEY_2=
ONEHOP_API_KEY_3=
#
# Fallback lama (kompatibilitas): comma-separated dalam satu variabel.
# Hanya dipakai jika ONEHOP_API_KEY_1..N tidak ada.
# ONEHOP_API_KEYS=key1,key2,key3
#
# Fallback single key (opsional):
# ONEHOP_API_KEY=key
#
# Urutan prioritas:
