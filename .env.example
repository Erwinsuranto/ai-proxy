# ─── AgentRouter ────────────────────────
# Provider OpenAI-compatible (base URL: https://agentrouter.org/v1).
# Mendukung POST /chat/completions (streaming & non-streaming, tool calls, vision)
# dan GET /models. Model diambil dinamis dari GET /v1/models (tidak di-hardcode).
#
# Multi key + round-robin + failover + cooldown. Isi satu key per baris (vertical):
# Loader otomatis membaca AGENTROUTER_API_KEY_1, AGENTROUTER_API_KEY_2, ... hingga N
# tanpa perlu di-hardcode. Baris kosong dilewati.
AGENTROUTER_API_KEY_1=
AGENTROUTER_API_KEY_2=
AGENTROUTER_API_KEY_3=
#
# Fallback lama (kompatibilitas): comma-separated dalam satu variabel.
# Hanya dipakai jika AGENTROUTER_API_KEY_1..N tidak ada.
# AGENTROUTER_API_KEYS=key1,key2,key3
#
# Fallback single key (opsional):
# AGENTROUTER_API_KEY=key
#
# Urutan prioritas:
# AGENTROUTER_API_KEY_1..N (vertical) → AGENTROUTER_API_KEYS (comma) → AGENTROUTER_API_KEY (single)
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
#
# Static catalog. AgentRouter routes claude-* models to the Anthropic Messages
# endpoint (base URL WITHOUT /v1) and all other models to the OpenAI /v1
# endpoint. Model discovery (GET /v1/models) is NOT required; when it is blocked
# by a WAF/CAPTCHA/HTML page (or returns nothing), the static catalog below keeps
# the provider healthy and routable. Format: array of { id, protocol }.
# To use a JSON file instead of inline: AGENTROUTER_MODELS_PATH=./config/agentrouter-models.json
# Example:
# AGENTROUTER_MODELS=[{"id":"anthropic/claude-opus-4.8","protocol":"anthropic"},{"id":"openai/gpt-5.6-sol","protocol":"openai"}]
#
# If unset, this built-in default catalog is used:
#   anthropic/claude-opus-4.8 (anthropic)
#   anthropic/claude-opus-5    (anthropic)
#   anthropic/claude-sonnet-5  (anthropic)
#   openai/gpt-5.6-sol         (openai)
#
# Health check: GET /internal/health/agentrouter (does NOT depend on /v1/models)
#
# Proxy mode: when true, requests/responses are forwarded verbatim to the base
# URL (no OpenAI <-> Anthropic body transformation). Authorization, timeout,
# retry and logging are still managed. Endpoint selection still honors the
# per-model protocol. Defaults to false (off).
AGENTROUTER_PROXY_MODE=false

