# Health check: GET /internal/health/onehop

# --------------------------------------------------
# SeekAI
# --------------------------------------------------
# Multi key + round-robin + failover.
# Loader otomatis membaca SEEKAI_API_KEY_1..5.
# Baris kosong dilewati.
SEEKAI_API_KEY_1=
SEEKAI_API_KEY_2=
SEEKAI_API_KEY_3=
SEEKAI_API_KEY_4=
SEEKAI_API_KEY_5=
# Fallback (opsional)
# SEEKAI_API_KEYS=key1,key2,key3,key4,key5
# SEEKAI_API_KEY=key
SEEKAI_BASE_URL=https://seekai.cc/v1
# SeekAI request timeout (ms). SeekAI generations can run long and must not be
# cut off at the global 30s timeout, so this is raised to 120000 by default.
# Other providers keep using the global TIMEOUT.
SEEKAI_TIMEOUT=120000
# Health check: GET /internal/health/seekai

