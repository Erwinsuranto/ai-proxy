# ============================================
# API Proxy Configuration
# ============================================
# Multi-provider proxy: NVIDIA NIM or Cloudflare Workers AI
# Copy this file to .env and adjust values:
#   cp .env.example .env
# ============================================

# Server host (0.0.0.0 = semua interface)
HOST=0.0.0.0

# Server port
PORT=3000

# ─── Timeout ────────────────────────────────
# Request timeout dalam milidetik (default: 30000)
TIMEOUT=30000

# ─── Logging ────────────────────────────────
# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Debug mode: true = cetak request/response ke console
# API Key akan disensor (hanya 4 karakter pertama & terakhir)
DEBUG=false

# ─── Provider Selection ─────────────────────
# The proxy auto-detects the provider based on configured env vars:
#   - Set CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN → Cloudflare Workers AI
#   - Otherwise → NVIDIA NIM (existing behavior)
# Only one provider can be active at a time.

# ─── Provider Enable / Disable ─────────────
# Seed provider status at startup (comma-separated provider IDs).
# Runtime toggles via the Admin API (GET/PATCH /admin/providers) are
# persisted in config/provider-state.json and survive restarts.
# DISABLE_PROVIDERS=stepfun,glm
# ENABLED_PROVIDERS=nvidia,openrouter

# ─── Provider Recovery Cooldown ─────────────
# Jeda recovery (restart/retry) provider setelah gagal, dalam milidetik.
# Default: 180000 (3 menit). Dipakai oleh SEMUA mekanisme cooldown agar
# tidak ada yang me-restart provider lebih cepat:
#   - provider-level cooldown (Provider Management / GET /admin/providers)
#   - per-key 429 cooldown (KeyManager)
#   - per-endpoint cooldown (Databricks EndpointManager)
#   - virtual route backend cooldown
# Selama cooldown aktif, request ke provider tersebut fail-fast (429) dengan
# pesan countdown — tanpa retry diam-diam dan tanpa fallback ke provider lain.
# PROVIDER_COOLDOWN_MS=180000

# ─── Cloudflare Workers AI ─────────────────
# To use Cloudflare, uncomment and set these:
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# ─── NVIDIA ─────────────────────────────
# (Ignored when Cloudflare is configured)
# Pilih salah satu metode:

# Metode 1: Single key
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Metode 2: Multi key dengan variabel terpisah
# Isi satu per satu. Aplikasi akan mengumpulkan semua yang terisi.
# NVIDIA_API_KEY_1=nvapi-key1-xxxx
# NVIDIA_API_KEY_2=nvapi-key2-xxxx
# NVIDIA_API_KEY_3=nvapi-key3-xxxx
# NVIDIA_API_KEY_4=nvapi-key4-xxxx
# NVIDIA_API_KEY_5=nvapi-key5-xxxx

# Metode 3: Multi key dengan comma-separated
# NVIDIA_API_KEYS=nvapi-key1-xxxx,nvapi-key2-xxxx,nvapi-key3-xxxx

# Urutan prioritas:
# NVIDIA_API_KEYS (comma) → NVIDIA_API_KEY_1..N (terpisah) → NVIDIA_API_KEY (single)
# Jika NVIDIA_API_KEYS diisi, metode lain diabaikan.

# API Base URL (default: https://integrate.api.nvidia.com/v1)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ─── OpenRouter ─────────────────────────
# Pilih salah satu metode:

# Metode 1: Single key
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Metode 2: Multi key dengan variabel terpisah
# Isi satu per satu. Aplikasi akan mengumpulkan semua yang terisi.
# OPENROUTER_API_KEY_1=sk-or-v1-key1-xxxx
# OPENROUTER_API_KEY_2=sk-or-v1-key2-xxxx
# OPENROUTER_API_KEY_3=sk-or-v1-key3-xxxx
# OPENROUTER_API_KEY_4=sk-or-v1-key4-xxxx
# OPENROUTER_API_KEY_5=sk-or-v1-key5-xxxx

# Metode 3: Multi key dengan comma-separated
# OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3

# Urutan prioritas:
# OPENROUTER_API_KEYS (comma) → OPENROUTER_API_KEY_1..N → OPENROUTER_API_KEY (single)
# Jika OPENROUTER_API_KEYS diisi, metode lain diabaikan.

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Opsional: Identifikasi aplikasi ke OpenRouter
# OPENROUTER_SITE_URL=https://example.com
# OPENROUTER_SITE_NAME=My App

# ─── StepFun ────────────────────────────
# Set STEPFUN_API_KEY untuk mengaktifkan provider nvidia-stepfun.
# Model: step-3.7-flash, step-2-16k-nightly, step-1-8k, step-1-32k, step-1-flash
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.ai/step_plan/v1

# ─── GoRouter ───────────────────────────
# Provider sekunder (prioritas: NVIDIA → GoRouter → OpenRouter).
# Mendukung endpoint OpenAI (POST /v1/chat/completions) dan Anthropic (POST /v1/messages).
# Model diambil dinamis dari GET /v1/models (tidak di-hardcode).
#
# Multi key + round-robin. Isi satu key per baris (vertical):
# Loader otomatis membaca GOROUTER_API_KEY_1, GOROUTER_API_KEY_2, ... hingga N
# tanpa perlu di-hardcode. Baris kosong dilewati.
GOROUTER_API_KEY_1=
GOROUTER_API_KEY_2=
GOROUTER_API_KEY_3=
#
# Fallback lama (kompatibilitas): comma-separated dalam satu variabel.
# Hanya dipakai jika GOROUTER_API_KEY_1..N tidak ada.
# GOROUTER_API_KEYS=key1,key2,key3
#
# Fallback single key (opsional):
# GOROUTER_API_KEY=key
#
# Urutan prioritas:
# GOROUTER_API_KEY_1..N (vertical) → GOROUTER_API_KEYS (comma) → GOROUTER_API_KEY (single)
GOROUTER_BASE_URL=https://gorouter.app/v1
#
# Jalur WAF sendiri: 403 yang terdeteksi sebagai halaman WAF/CAPTCHA Cloudflare
# (content-type text/html atau pesan abusive/non-compliant/access denied) di-retry
# sendiri dengan backoff eksponensial (3x, 1.5s→3s→6s) + User-Agent browser,
# terpisah dari jalur TabiToken.

# ─── InferX ──────────────────────────────
# Provider OpenAI-compatible (endpoint: https://model.inferx.net/endpoints/v1).
# Mendukung POST /chat/completions (streaming & non-streaming, tool calls, vision)
# dan GET /models. Model diambil dinamis dari GET /v1/models (tidak di-hardcode).
#
# Multi key + round-robin + failover. Isi satu key per baris (vertical):
# Loader otomatis membaca INFERX_API_KEY_1, INFERX_API_KEY_2, ... hingga N
# tanpa perlu di-hardcode. Baris kosong dilewati.
INFERX_API_KEY_1=
INFERX_API_KEY_2=
INFERX_API_KEY_3=
#
# Fallback lama (kompatibilitas): comma-separated dalam satu variabel.
# Hanya dipakai jika INFERX_API_KEY_1..N tidak ada.
# INFERX_API_KEYS=key1,key2,key3
#
# Fallback single key (opsional):
# INFERX_API_KEY=key
#
# Urutan prioritas:
# INFERX_API_KEY_1..N (vertical) → INFERX_API_KEYS (comma) → INFERX_API_KEY (single)
INFERX_BASE_URL=https://model.inferx.net/endpoints/v1
#
# Health check: GET /internal/health/inferx

