# ─── Kie.ai (api.kie.ai, multi-route) ───────────
# SATU provider, SATU base URL, tiga route (lihat src/lib/kie-routes.ts):
#   kie-gemini  POST /gemini/v1/models/{model}:streamGenerateContent (protocol gemini)
#   kie-claude  POST /claude/v1/messages (protocol anthropic-messages)
#   kie-codex   POST /codex/v1/responses (protocol openai-responses)
# Model diambil dari GET /codex/v1/models + katalog statis fallback.
# Multi key + round-robin + failover + cooldown (satu pool untuk semua route).
# Loader otomatis membaca KIE_API_KEY_1..N.
# Setelah migrasi ke Admin UI, key UI menjadi satu-satunya sumber runtime.
KIE_API_KEY_1=
KIE_API_KEY_2=
# Fallback (opsional):
# KIE_API_KEYS=key1,key2,key3
# KIE_API_KEY=key
KIE_BASE_URL=https://api.kie.ai
# Request timeout (ms).
KIE_TIMEOUT=120000
# Retry otomatis untuk error transien (HTTP 500/502/503/timeout/network) di
# semua route Kie (terutama Codex yang kadang balas 500 "Server exception"):
# maksimal 3 attempt TOTAL dengan jeda tetap 1500ms, key yang sama,
# tanpa backoff. Error 4xx tidak pernah di-retry. (Fixed di kode.)
# Health check: GET /internal/health/kie.ai (per-route: kie-gemini/kie-claude/kie-codex)

# ─── Databricks ────────────────────────# Isi satu endpoint per baris: DATABRICKS_ENDPOINT_1, DATABRICKS_ENDPOINT_2, ...
# Format: baseURL|API_KEY
# Setiap endpoint (base URL + API key) berasal dari workspace Databricks berbeda.
# Jika satu endpoint error (401/403/429/timeout/5xx),
# akan otomatis beralih ke endpoint berikutnya.
# Model: prefix 'databricks/' akan dirutekan ke Databricks.
# Contoh:
# DATABRICKS_ENDPOINT_1=https://dbc-aaa.cloud.databricks.com/serving-endpoints|dapi-key-1
# DATABRICKS_ENDPOINT_2=https://dbc-bbb.cloud.databricks.com/serving-endpoints|dapi-key-2
# DATABRICKS_ENDPOINT_3=https://dbc-ccc.cloud.databricks.com/serving-endpoints|dapi-key-3
#
# Model Alias Mapping (opsional):
# Jika nama model di Databricks berbeda dari nama yang dikirim gateway,
# gunakan DATABRICKS_MODEL_MAP_PATH untuk file JSON mapping:
#   DATABRICKS_MODEL_MAP_PATH=/path/to/databricks-model-map.json
# File JSON berisi pasangan "model-asli": "nama-deployment-databricks":
#   { "qwen/qwen3.5-122b-a10b": "qwen3", "meta/llama-3.3-70b": "llama-3-3-70b" }
# Atau via env var (satu per baris):
# Encoding: '/' -> '__', '.' -> '_'
#   DATABRICKS_MODEL_MAP_qwen__qwen3_5_122b_a10b=qwen3
#   DATABRICKS_MODEL_MAP_meta__llama_3_3_70b=llama-3-3-70b
# Virtual Model Alias (opsional):
# Memetakan nama virtual (contoh: "databricks/qwen") ke deployment name sebenarnya.
# Client cukup request: databricks/qwen, gateway akan mengirim qwen3 ke Databricks.
#   DATABRICKS_ALIAS_PATH=/path/to/databricks-aliases.json
# File JSON:
#   { "databricks/qwen": "qwen3", "databricks/llama": "llama-3-3-70b" }
# Atau via env var (satu per baris):
#   DATABRICKS_ALIAS_databricks__qwen=qwen3
#   DATABRICKS_ALIAS_databricks__llama=llama-3-3-70b
# Virtual alias dicari lebih dulu, baru model alias.
# Endpoint debug: GET /internal/databricks/aliases
#
# Jika mapping ditemukan, model akan diubah sebelum dikirim ke Databricks.
# Logging akan menampilkan: "Model Alias: original -> mapped" atau "Virtual Alias: ... -> ..."
# Endpoint debug: GET /internal/databricks/model-map

# ─── Model Alias (Lookup) ───
# Memetakan nama model yang dikirim client ke nama model di ModelRegistry.
# Alias HANYA untuk lookup ModelRegistry — nama model yang dikirim ke provider
# tetap nama yang terdaftar di registry (tidak diubah).
#
# Contoh: client mengirim "deepseek-ai/deepseek-v4-flash" tetapi NVIDIA
# mendaftarkan "deepseek-v4-flash". Tanpa alias → model tidak ditemukan.
# Dengan alias → lookup berhasil, upstream tetap "deepseek-v4-flash".
#
# Konfigurasi via JSON file:
# MODEL_ALIASES_PATH=/path/to/model-aliases.json
# File JSON:
# {
#   "deepseek-ai/deepseek-v4-flash": "deepseek-v4-flash",
#   "deepseek-ai/deepseek-v4-pro": "deepseek-v4-pro"
# }
#
# Atau via inline JSON (env var):
# MODEL_ALIASES={"deepseek-ai/deepseek-v4-flash":"deepseek-v4-flash"}
#
# Kelola alias runtime via admin API:
#   GET    /admin/aliases
#   POST   /admin/aliases        { "alias": "...", "target": "..." }
#   DELETE /admin/aliases/:alias
# Contoh: "claude-4.8" memetakan ke upstream "claude-opus-4-8" (dilayani GoRouter
# dan SeekAI; GoRouter diprioritaskan, SeekAI fallback).
# MODEL_ALIASES={"claude-4.8":"claude-opus-4-8"}

# ─── Provider Backend Model Mapping ───
# Setiap provider bisa memakai nama model backend yang berbeda, sementara
# client tetap mengirim model yang sama. ModelRegistry tetap memakai model
# client/virtual; backendModel hanya disubstitusi sebelum request upstream.
#
# Contoh: client selalu mengirim "deepseek-ai/deepseek-v4-flash":
#   - NVIDIA  : deepseek-ai/deepseek-v4-flash  (tanpa mapping)
#   - ZEN     : deepseek-v4-flash-free
#
# POST /admin/models
# { "model": "deepseek-ai/deepseek-v4-flash", "providerId": "zen", "priority": 2, "backendModel": "deepseek-v4-flash-free" }
#
# Kelola mapping runtime via admin API:
#   GET    /admin/models
#   POST   /admin/models        { "model", "providerId", "priority?", "enabled?", "backendModel?" }
#   PATCH  /admin/models/:providerId/:encodedModel   { "priority"? | "enabled"? | "backendModel"? }
#   DELETE /admin/models/:providerId/:encodedModel
#
# UI: Web Admin (/admin/zen) menampilkan kartu "Model Mapping" untuk mengatur
# backendModel per provider tanpa restart. Model yang dikirim client TIDAK
# pernah diubah; kosongkan backendModel agar memakai nama model yang sama.

# ─── Virtual Routes (Multi-Provider Model) ───# Satu model virtual bisa memiliki beberapa backend/provider.
# Gateway akan memilih backend berdasarkan strategi dan fallback jika gagal.
# Client cukup request model virtual, gateway yang menentukan provider.
#
# Konfigurasi via JSON file:
# VIRTUAL_ROUTES_PATH=/path/to/virtual-routes.json
# File JSON:
# {
#   "virtualModels": [
#     {
#       "virtualModel": "qwen/qwen3.5-122b-a10b",
#       "strategy": "round_robin",
#       "backends": [
#         { "provider": "databricks", "model": "databricks-qwen35-122b-a10b" },
#         { "provider": "openrouter", "model": "qwen/qwen3.5-122b-a10b" }
#       ]
#     }
#   ]
# }
#
# Atau via inline JSON (env var):
# VIRTUAL_ROUTES=[{"virtualModel":"qwen/qwen3.5-122b-a10b","strategy":"round_robin","backends":[{"provider":"databricks","model":"databricks-qwen35-122b-a10b"},{"provider":"openrouter","model":"qwen/qwen3.5-122b-a10b"}]}]
#
# Strategi yang tersedia:
#   round_robin   - Bergantian provider setiap request
#   priority      - Urut sesuai daftar, backup jika gagal
#   random        - Pilih acak dari yang sehat
#   fastest       - Pilih dengan latency rata-rata terendah
#   least_latency - Sama seperti fastest
#
# Setiap backend memiliki health check terpisah.
# Jika backend gagal (429/503/5xx), otomatis cooldown PROVIDER_COOLDOWN_MS (default 180 detik).
# Endpoint debug: GET /internal/virtual-routes