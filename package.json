{
  "name": "api-proxy",
  "version": "1.0.0",
  "description": "OpenAI Compatible Multi-Provider API Proxy",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.admin.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "tsc --noEmit && tsc -p tsconfig.admin.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --reporter=verbose tests/*.test.ts",
    "verify:nvidia": "bash scripts/verify-nvidia.sh"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "archiver": "^8.0.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "playwright": "^1.62.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.13.4",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.1.3"
  }
}
